<idea-plugin>
    <id>net.rusrusme.glaze</id>
    <name>GlazeScript</name>
    <vendor email="support@rusrusme.net" url="https://github.com/rusrusme">rusrusme</vendor>

    <description><![CDATA[
    Language support for GlazeScript (.gscript), the scripting language for GlacialEngine.
    Features:
    - Syntax highlighting and token recognition
    - Scope-aware identifier and symbol resolution
    - Auto-formatting and indentation
    - ECS loop and system semantic diagnostics
    - Intelligent member, swizzle, and intrinsic completion
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Glaze Script File"
                  implementationClass="net.rusrusme.glaze.core.GFileType"
                  fieldName="INSTANCE"
                  language="GlazeScript"
                  extensions="gscript"/>

        <lang.parserDefinition language="GlazeScript"
                               implementationClass="net.rusrusme.glaze.core.GParserDefinition"/>

        <lang.syntaxHighlighterFactory language="GlazeScript"
                                       implementationClass="net.rusrusme.glaze.highlight.GSyntaxHighlighterFactory"/>

        <lang.braceMatcher language="GlazeScript"
                           implementationClass="net.rusrusme.glaze.core.GBraceMatcher"/>

        <lang.commenter language="GlazeScript"
                        implementationClass="net.rusrusme.glaze.core.GCommenter"/>

        <completion.contributor language="GlazeScript"
                                implementationClass="net.rusrusme.glaze.core.GCompletionContributor"/>

        <psi.referenceContributor language="GlazeScript"
                                  implementation="net.rusrusme.glaze.psi.GReferenceContributor"/>

        <annotator language="GlazeScript"
                   implementationClass="net.rusrusme.glaze.annotator.GAnnotator"/>

        <lang.formatter language="GlazeScript"
                        implementationClass="net.rusrusme.glaze.formatting.GFormattingModelBuilder"/>

        <codeStyleSettingsProvider
                implementation="net.rusrusme.glaze.formatting.GLanguageCodeStyleSettingsProvider"/>

        <colorSettingsPage
                implementation="net.rusrusme.glaze.highlight.GColorSettingsPage"/>

        <quoteHandler fileType="Glaze Script File"
                      className="net.rusrusme.glaze.core.GQuoteHandler"/>

        <internalFileTemplate name="Glaze Script File"/>
    </extensions>

    <actions>
        <action id="Glaze.NewGlazeFile"
                class="net.rusrusme.glaze.action.GCreateFileAction"
                text="Glaze Script File"
                description="Create new Glaze Script file">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile"/>
        </action>
    </actions>
</idea-plugin>